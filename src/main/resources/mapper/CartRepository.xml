<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shop.repository.CartRepository">
    <resultMap id="cartResultMap" type="com.shop.entity.Cart">
        <id property="cartId" column="CART_ID" />
        <result property="memberId" column="MEMBER_ID" />
        <result property="regTime" column="REG_TIME" />
    </resultMap>

    <select id="findByMemberId" resultMap="cartResultMap">
        SELECT CART_ID, MEMBER_ID, REG_TIME
        FROM CART
        WHERE MEMBER_ID = #{memberId}
    </select>

    <select id="findById" resultMap="cartResultMap">
        SELECT CART_ID, MEMBER_ID, REG_TIME
        FROM CART
        WHERE CART_ID = #{cartId}
    </select>

    <insert id="save" parameterType="com.shop.entity.Cart">
        <selectKey keyProperty="cartId" resultType="long" order="BEFORE">
            SELECT CART_SEQ.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO CART (CART_ID, MEMBER_ID, REG_TIME)
        VALUES (#{cartId}, #{memberId}, SYSDATE)
    </insert>

</mapper>