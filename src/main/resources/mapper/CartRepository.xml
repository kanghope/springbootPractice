<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shop.repository.CartRepository">

    <select id="findByMemberId" resultType="com.shop.entity.Cart">
        SELECT *
        FROM CART
        WHERE MEMBER_ID = #{memberId}
    </select>

    <insert id="save" parameterType="com.shop.entity.Cart">
        <selectKey keyProperty="cartId" resultType="long" order="BEFORE">
            SELECT CART_SEQ.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO CART (CART_ID, MEMBER_ID, REG_TIME)
        VALUES (#{cartId}, #{memberId}, SYSDATE)
    </insert>

</mapper>