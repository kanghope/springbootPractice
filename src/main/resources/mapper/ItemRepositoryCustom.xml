    <select id="getMainItemCount" parameterType="map" resultType="long">
        SELECT COUNT(I.ITEM_ID)
        FROM ITEM I
        INNER JOIN ITEM_IMG IMG ON I.ITEM_ID = IMG.ITEM_ID
        <where>
            AND IMG.REP_IMG_YN = 'Y'
            <if test="searchDto.searchQuery != null and searchDto.searchQuery != ''">
                AND I.ITEM_NM LIKE '%' || #{searchDto.searchQuery} || '%'
            </if>
        </where>
    </select>
</mapper>